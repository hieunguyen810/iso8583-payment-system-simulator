@Library('iso8583-pipeline-lib') _

ciPipeline([
    buildType: 'maven',
    build: [
        workDir: 'source',
        profiles: ['production'],
        jvmArgs: '-Xmx4g -XX:+UseG1GC'
    ],
    test: [
        workDir: 'source',
        coverage: true,
        parallel: true
    ],
    integrationTest: [
        enabled: true,
        workDir: 'source',
        testPattern: '**/*IT.java'
    ],
    security: [
        enabled: true
    ],
    sonar: [
        enabled: true,
        server: 'SonarQube',
        projectKey: 'iso8583-payment-processor'
    ],
    package: [
        workDir: 'source',
        securityScan: true
    ],
    deploy: [
        type: 'docker',
        imageName: 'iso8583/payment-processor',
        registry: 'registry.company.com',
        securityScan: true,
        push: true,
        buildArgs: [
            'BUILD_VERSION': env.BUILD_VERSION,
            'GIT_COMMIT': env.GIT_COMMIT
        ]
    ],
    notifications: [
        slack: [
            channel: '#iso8583-deployments'
        ]
    ]
])